# Netfilter / ipset / ipvs options k3s + kube-proxy + flannel need.
# Merged on top of the firecracker reference guest config.
#
# Expose the running kernel's config at /proc/config.gz — lets us
# verify on the live VM exactly what got compiled in.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# NETFILTER_ADVANCED is the gate: the firecracker minimal config has it
# OFF, which HIDES every advanced netfilter symbol below (MARK, COMMENT,
# IP_VS, ...) so they cannot be enabled. Must be y first.
CONFIG_NETFILTER_ADVANCED=y
# MARK: enable both the prompt symbols AND the backing symbol. The
# prompt symbols `select NETFILTER_XT_MARK` (which builds xt_mark.o).
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_VXLAN=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NF_CONNTRACK_PROCFS=y
